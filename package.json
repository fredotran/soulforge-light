{
  "name": "@proxysoul/soulforge-light",
  "version": "1.0.0",
  "description": "Lightweight terminal AI coding assistant",
  "repository": {
    "type": "git",
    "url": "https://github.com/proxysoul/soulforge-light.git"
  },
  "module": "src/boot.tsx",
  "type": "module",
  "license": "MIT",
  "bin": {
    "soulforge": "./bin.sh",
    "sf": "./bin.sh"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/boot.tsx",
    "build": "bun build src/boot.tsx --outdir dist --target bun --external react-devtools-core",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "bun-types": "1.3.13",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/google": "^3.0.73",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/mistral": "^3.0.36",
    "@ai-sdk/deepseek": "^2.0.35",
    "@opentui/react": "0.2.0",
    "ai": "^6.0.182",
    "react": "19.2.5",
    "undici": "^8.1.0",
    "zod": "4.3.6",
    "zustand": "5.0.12"
  }
}
